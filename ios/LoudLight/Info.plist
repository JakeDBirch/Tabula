<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Loud Light</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- The UIScene lifecycle, which iOS 26 warns about and the iOS 27 SDK turns
	     into a launch-time assert. Single scene deliberately: multiple windows
	     would mean two schedulers writing the same localStorage key. Adopting
	     the lifecycle and declining multi-window are separate choices, and this
	     is the one that keeps both properties. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<!-- Keeps the sequencer running when the screen locks or you switch away to
	     check something. WKWebView's background audio support has historically
	     been unreliable, so verify this on a device before relying on it — and
	     remove the key if it turns out not to hold, because declaring a
	     background mode the app doesn't use is itself a review rejection. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- arm64, not the armv7 Xcode's template still writes: the deployment
	     target is iOS 16, every device that can run it is 64-bit, and the
	     binary has no 32-bit slice to back the claim up. -->
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleLightContent</string>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<!-- iPhone is landscape-only: one orientation to hold the instrument in,
	     rather than a layout that reflows under your hands mid-take. Both
	     rotations, so it follows the hand rather than dictating a side. Note
	     what this does NOT buy: the grid is square and height-bound, so
	     landscape makes it marginally SMALLER, not bigger (measured across
	     four iPhone sizes: 355->343px on an SE, 410->398px on a 15 Pro Max).
	     What it buys is the rail — transport, layers and sheet openers beside
	     the grid instead of stacked under it. The portrait layout is untouched
	     and still ships on the web, where the orientation isn't ours to pick. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- All four on iPad. Not optional for long: iPadOS 26 already warns that
	     "support for all orientations will soon be required", and it ignores
	     UIRequiresFullScreen — so the app is a resizable window whatever this
	     file says, and the layout has to hold at any size rather than be
	     pinned to one. It does; that is checked at build time only in the
	     sense that the web layout is flex/dvh throughout. -->
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- Cloud sync (Supabase) is the only network the app does, and it is TLS.
	     No ATS exceptions, which is one fewer thing for review to ask about. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
