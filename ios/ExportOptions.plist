<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Distribution to App Store Connect, which is what feeds TestFlight.
	     On Xcode older than 15.3 this value is spelled "app-store". -->
	<key>method</key>
	<string>app-store-connect</string>
	<!-- Upload straight from the export step instead of leaving an .ipa for
	     someone to drag into Transporter. Change to "export" to get a file. -->
	<key>destination</key>
	<string>upload</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<!-- dSYMs, so a crash in TestFlight arrives symbolicated rather than as
	     hex addresses. -->
	<key>uploadSymbols</key>
	<true/>
	<!-- Bitcode has been dead since Xcode 14; stating it avoids a warning. -->
	<key>compileBitcode</key>
	<false/>
	<!-- Let App Store Connect assign the build number if one collides. -->
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
</dict>
</plist>
